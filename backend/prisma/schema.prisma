// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PATIENT
  RECEPTIONIST
}

enum LabStatus {
  PENDING
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
}

model User {
  id String @id @default(cuid())

  name     String
  email    String @unique
  password String

  role Role

  doctor Doctor?
  patient Patient?

  createdAt DateTime @default(now())
}

model Patient {
  id String @id @default(cuid())

  userId String? @unique

  user User? @relation(fields:[userId], references:[id])

  patientCode String @unique

  firstName String
  lastName  String

  age    Int
  gender String

  bloodGroup String?

  phone String
  email String?

  address String

  emergencyPhone String?

  allergies String?

  diseaseHistory String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  labRequests LabRequest[]

  labReports LabReport[]

  followUps FollowUp[]

  admissions Admission[]

  bills Bill[]

  payments Payment[]
}

model Doctor {
  id String @id @default(cuid())
  
  userId String @unique

  user User @relation(fields:[userId], references:[id])

  doctorCode String @unique

  name  String
  email String @unique

  specialization String

  experience Int

  qualification String?

  phone String

  gender String?

  address String?

  departmentId String

  department Department @relation(fields: [departmentId], references: [id])

  appointments Appointment[]
  labRequests  LabRequest[]
  followUps    FollowUp[]
  admissions   Admission[]

  createdAt DateTime @default(now())
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

model Appointment {
  id String @id @default(cuid())

  patientId String
  doctorId  String

  date DateTime
  time String

  tokenNumber Int?

  checkedIn Boolean @default(false)

  status AppointmentStatus @default(PENDING)

  patient Patient @relation(fields: [patientId], references: [id])

  doctor Doctor @relation(fields: [doctorId], references: [id])

  consultation Consultation?

  createdAt DateTime @default(now())
}

model Consultation {
  id String @id @default(cuid())

  appointmentId String @unique

  symptoms  String?
  diagnosis String?
  notes     String?

  bloodPressure String?
  pulse         String?
  temperature   String?
  oxygenLevel   String?

  height String?
  weight String?

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  prescriptions Prescription[]

  createdAt DateTime @default(now())
}

model Prescription {
  id String @id @default(cuid())

  consultationId String

  medicine  String
  dosage    String
  frequency String
  duration  String

  consultation Consultation @relation(fields: [consultationId], references: [id])

  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  doctors Doctor[]
}

model LabRequest {
  id String @id @default(cuid())

  patientId String
  doctorId  String

  testName String

  status LabStatus @default(PENDING)

  notes String?

  patient Patient @relation(fields: [patientId], references: [id])

  doctor Doctor @relation(fields: [doctorId], references: [id])

  report LabReport?

  createdAt DateTime @default(now())
}

model FollowUp {
  id String @id @default(cuid())

  patientId String
  doctorId  String

  nextVisitDate DateTime

  reason String

  notes String?

  status FollowUpStatus @default(PENDING)

  patient Patient @relation(fields: [patientId], references: [id])

  doctor Doctor @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
}

model Room {
  id String @id @default(cuid())

  roomNumber String @unique

  wardId String

  ward Ward @relation(fields: [wardId], references: [id])

  beds Bed[]

  createdAt DateTime @default(now())
}

model Ward {
  id String @id @default(cuid())

  name String @unique

  description String?

  rooms Room[]

  createdAt DateTime @default(now())
}

model Bed {
  id String @id @default(cuid())

  bedNumber String @unique

  roomId String

  status BedStatus @default(AVAILABLE)

  room Room @relation(fields: [roomId], references: [id])

  admissions Admission[]
}

model Admission {
  id String @id @default(cuid())

  patientId String

  doctorId String

  bedId String

  diagnosis String

  admissionDate DateTime @default(now())

  dischargeDate DateTime?

  status AdmissionStatus @default(ADMITTED)

  patient Patient @relation(fields: [patientId], references: [id])

  doctor Doctor @relation(fields: [doctorId], references: [id])

  bed Bed @relation(fields: [bedId], references: [id])

  createdAt DateTime @default(now())
}

model Bill {
  id String @id @default(cuid())

  billNumber String @unique

  patientId String

  patient Patient @relation(fields: [patientId], references: [id])

  consultationFee Float @default(0)

  labFee Float @default(0)

  roomFee Float @default(0)

  medicineFee Float @default(0)

  otherCharges Float @default(0)

  totalAmount Float

  paidAmount Float @default(0)

  paymentStatus PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
}

model LabReport {
  id String @id @default(cuid())

  patientId String

  labRequestId String @unique

  testName String

  result String?

  fileUrl String?

  patient Patient @relation(fields: [patientId], references: [id])

  labRequest LabRequest @relation(fields: [labRequestId], references: [id])

  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(cuid())

  patientId String

  amount Float

  status String @default("PENDING")

  paymentDate DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}
